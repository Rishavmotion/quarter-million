{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quarter-million",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "kv_namespaces": [
    {
      "binding": "TRACKER",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
